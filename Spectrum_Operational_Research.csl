
<style xmlns="http://purl.org/net/xbiblio/csl" version="1.0" class="in-text" default-locale="en-US">
  <info>
    <title>Spectrum of Operational Research</title>
    <id>http://www.zotero.org/styles/spectrum-operational-research-custom</id>
    <link href="http://www.zotero.org/styles/spectrum-operational-research-custom" rel="self"/>
    <category citation-format="numeric"/>
    <summary>Bracketed numeric citations and APA-like reference list.</summary>
    <updated>2026-11-18T00:00:00+00:00</updated>
  </info>
  <citation collapse="citation-number">
    <sort>
      <key variable="citation-number"/>
    </sort>
    <layout prefix="[" suffix="]" delimiter=", ">
      <text variable="citation-number"/>
    </layout>
  </citation>
  <bibliography hanging-indent="true" et-al-min="8" et-al-use-first="6">
    <sort>
      <key variable="citation-number"/>
    </sort>
    <layout>
      <text variable="citation-number" prefix="[" suffix="] "/>
      <names variable="author" delimiter=", ">
        <name name-as-sort-order="all" sort-separator=", " initialize-with=". " and="symbol" delimiter=", " delimiter-precedes-last="always"/>
        <et-al term="et-al"/>
      </names>
      <date variable="issued" prefix=" (" suffix=").">
        <date-part name="year"/>
      </date>
      <text variable="title" suffix=". "/>
      <text variable="container-title" font-style="italic" suffix=", "/>
      <text variable="volume" font-style="italic"/>
      <text variable="issue" prefix="(" suffix=")"/>
      <text variable="page" prefix=", "/>
      <text variable="DOI" prefix=". https://doi.org/"/>
    </layout>
  </bibliography>
</style>
